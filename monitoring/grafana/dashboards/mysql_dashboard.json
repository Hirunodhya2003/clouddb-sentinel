{
  "uid": "clouddb-mysql",
  "title": "CloudDB Sentinel - MySQL 8.0 Performance",
  "description": "Owner: Member 09 - MySQL connections, slow queries, QPS, and InnoDB buffer pool",
  "tags": [
    "clouddb-sentinel",
    "mysql",
    "adbms",
    "member-09"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Connection Pool Utilization (%)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(mysql_global_status_threads_connected / mysql_global_variables_max_connections) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Threads Connected / Running",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Connected",
          "refId": "A"
        },
        {
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "Running",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cumulative Slow Queries",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "mysql_global_status_slow_queries",
          "refId": "A"
        }
      ]
    }
  ]
}
