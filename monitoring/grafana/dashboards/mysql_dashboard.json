{
  "uid": "clouddb-mysql",
  "title": "CloudDB Sentinel - MySQL 8.0 Performance",
  "description": "Owner: Member 09 - MySQL connections, slow queries, QPS, and InnoDB buffer pool",
  "tags": ["clouddb-sentinel", "mysql", "adbms", "member-09"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Connection Pool Utilization (%)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(mysql_global_status_threads_connected / mysql_global_variables_max_connections) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Threads Connected / Running",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "Connected", "refId": "A" },
        { "expr": "mysql_global_status_threads_running", "legendFormat": "Running", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cumulative Slow Queries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "mysql_global_status_slow_queries", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Aborted Connections",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "mysql_global_status_aborted_connects", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MySQL Queries per Second (QPS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[1m])",
          "legendFormat": "Queries/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "InnoDB Buffer Pool Reads vs Read Requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_innodb_buffer_pool_read_requests[1m])",
          "legendFormat": "Logical Read Requests/s",
          "refId": "A"
        },
        {
          "expr": "rate(mysql_global_status_innodb_buffer_pool_reads[1m])",
          "legendFormat": "Disk Reads/s",
          "refId": "B"
        }
      ]
    }
  ]
}
