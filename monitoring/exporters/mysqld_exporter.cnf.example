# Owner: Member 09
# Example MySQL client credentials for prometheus/mysqld_exporter.
# Copy to mysqld_exporter.cnf (never commit real passwords) and create a dedicated
# least-privilege MySQL user:
#   CREATE USER 'exporter'@'%' IDENTIFIED BY 'CHANGE_ME' WITH MAX_USER_CONNECTIONS 3;
#   GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';

[client]
user=exporter
password=CHANGE_ME_STRONG_PASSWORD
host=mysql
port=3306
